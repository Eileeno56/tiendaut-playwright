{
  "name": "tiendaut-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de práctica y pruebas E2E con Playwright - Unidad II GPDS",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test --grep-invert @laboratorio",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium --grep-invert @laboratorio",
    "test:laboratorio": "playwright test --config=playwright.laboratorio.config.ts",
    "test:estabilidad": "playwright test --repeat-each=5 --fail-on-flaky-tests",
    "test:evidencias": "playwright test --config=playwright.evidencias.config.ts",
    "report": "playwright show-report",
    "lint": "eslint tests/"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript-eslint": "^8.71.2"
  }
}
